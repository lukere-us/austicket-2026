# Copy to .env before running admin locally.
# Windows: copy .env.example .env

# Use 3003 locally — Next.js may fall back to 3001 when 3000 is busy.
PORT=3003
NODE_ENV=production

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=aus-booking

# Long random string (32+ characters). Used for session cookies.
SESSION_SECRET=change-me-to-a-long-random-secret

# Optional: directory for AdminJS component bundle cache
# ADMIN_JS_TMP_DIR=.adminjs
