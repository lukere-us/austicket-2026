# Copy to .env and fill in values before running admin in production.
# Windows: copy .env.example .env

PORT=3001
NODE_ENV=production

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=austicket
DB_PASSWORD=change-me
DB_NAME=aus-booking

# Long random string (32+ characters). Used for session cookies.
SESSION_SECRET=change-me-to-a-long-random-secret

# Optional: directory for AdminJS component bundle cache
# ADMIN_JS_TMP_DIR=.adminjs
